# Project identity — the single source of truth.
# Change a value here, then run `make sync`: it updates go.mod and Go imports,
# README and docs, build info, Docker labels and release config across the repo.
# This file is committed to git. Never put secrets here; secrets go in .env (gitignored).

PROJECT_DOMAIN=chowki.dev
GITHUB_OWNER=852hamza
GITHUB_REPO=chowki

# Optional overrides. Leave empty to use the defaults:
#   WEBSITE_URL = https://$PROJECT_DOMAIN   (free option before buying a domain: https://852hamza.github.io/chowki)
#   DOCS_URL    = $WEBSITE_URL/docs
WEBSITE_URL=
DOCS_URL=
