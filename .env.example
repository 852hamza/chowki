# Copy this file to .env for local development: cp .env.example .env
# .env is gitignored, so real keys never reach git. Real environment variables always win over .env.
# Project identity (domain, GitHub owner/repo) is NOT here — it lives in project.env.

# Where this Chowki instance is reachable (used in `chowki setup` snippets and dashboard links)
CHOWKI_PUBLIC_URL=http://localhost:8080

# Master key (32 random bytes, base64). Leave empty to use the key file created by `chowki init`.
CHOWKI_MASTER_KEY=

# Provider keys — fill in only the providers you use
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Any OpenAI-compatible provider: reference its variable from chowki.yaml with api_key_env
DEEPSEEK_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
